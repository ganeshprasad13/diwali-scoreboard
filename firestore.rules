rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only YOU (your Firebase Auth user id) can read or write. Everything else is denied.
    match /events/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == 'PASTE_YOUR_ADMIN_UID_HERE';
    }
  }
}
